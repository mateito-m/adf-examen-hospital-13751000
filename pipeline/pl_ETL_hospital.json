				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "SET XACT_ABORT ON;\n\nBEGIN TRY\n    BEGIN TRANSACTION;\n\n    -- ==========================================\n    -- 1. LIMPIAR TABLAS DE HECHOS\n    -- ==========================================\n\n    DELETE FROM gold.fact_facturacion;\n    DELETE FROM gold.fact_admisiones;\n\n    -- ==========================================\n    -- 2. LIMPIAR DIMENSIONES\n    -- ==========================================\n\n    DELETE FROM gold.dim_servicio_cargo;\n    DELETE FROM gold.dim_diagnostico;\n    DELETE FROM gold.dim_departamento;\n    DELETE FROM gold.dim_paciente;\n    DELETE FROM gold.dim_fecha;\n\n    -- ==========================================\n    -- 3. REINICIAR CLAVES IDENTITY\n    -- ==========================================\n\n    DBCC CHECKIDENT ('gold.fact_facturacion', RESEED, 0);\n    DBCC CHECKIDENT ('gold.fact_admisiones', RESEED, 0);\n\n    DBCC CHECKIDENT ('gold.dim_servicio_cargo', RESEED, 0);\n    DBCC CHECKIDENT ('gold.dim_diagnostico', RESEED, 0);\n    DBCC CHECKIDENT ('gold.dim_departamento', RESEED, 0);\n    DBCC CHECKIDENT ('gold.dim_paciente', RESEED, 0);\n\n    -- dim_fecha no tiene IDENTITY\n\n    COMMIT TRANSACTION;\n\nEND TRY\nBEGIN CATCH\n\n    IF @@TRANCOUNT > 0\n        ROLLBACK TRANSACTION;\n\n    THROW;\n\nEND CATCH;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
