						{
							"type": "NonQuery",
							"text": "IF NOT EXISTS (\n    SELECT 1\n    FROM gold.dim_diagnostico\n    WHERE diagnostico_key = 1971\n)\nBEGIN\n    SET IDENTITY_INSERT gold.dim_diagnostico ON;\n\n    INSERT INTO gold.dim_diagnostico (\n        diagnostico_key,\n        codigo_icd,\n        descripcion_patologia,\n        nivel_severidad\n    )\n    VALUES (\n        1971,\n        'UNKNOWN',\n        'Sin diagnóstico registrado',\n        'Unknown'\n    );\n\n    SET IDENTITY_INSERT gold.dim_diagnostico OFF;\nEND;"
						}
